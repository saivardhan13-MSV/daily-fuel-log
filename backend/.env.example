# Same Supabase project the Next.js app uses. The anon key (not the
# service-role key) is deliberate: requests run as the signed-in user, so
# Postgres RLS stays the final isolation layer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
USDA_FDC_API_KEY=
# How bearer tokens are checked. jwks (default): verify the signature locally
# against Supabase's public keys, no extra network call. remote: ask Supabase
# Auth on every request (also catches revoked sessions, but slower).
# AUTH_MODE=jwks
# Origins allowed to call this API from a browser (Next.js dev server).
CORS_ORIGINS=http://localhost:3000
