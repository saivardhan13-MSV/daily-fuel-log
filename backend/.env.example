# Same Supabase project the Next.js app uses. The anon key (not the
# service-role key) is deliberate: requests run as the signed-in user, so
# Postgres RLS stays the final isolation layer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
USDA_FDC_API_KEY=
# Origins allowed to call this API from a browser (Next.js dev server).
CORS_ORIGINS=http://localhost:3000
