# Copy this file to .env.local and fill in the values below.
# .env.local is already gitignored — never commit real keys.

# Supabase (Project Settings -> API Keys)
# Note: Supabase's dashboard now labels these "Publishable key" and "Secret key"
# instead of the old "anon" / "service_role" names — same values, new labels.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser ("Secret key" in the dashboard)
SUPABASE_SERVICE_ROLE_KEY=

# URL of the Python API (backend/), which owns all data access. REQUIRED: the app
# can't load or save anything without it. Server-only, no trailing slash.
#   Local backend:  API_URL=http://localhost:8010  (run `uvicorn app.main:app --port 8010` in backend/)
#   Deployed:       the URL of the API's Vercel project (see backend/README.md)
API_URL=

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Read by the Python API, not by this app: set it in backend/.env or the API's
# Vercel project.
USDA_FDC_API_KEY=

# Used to build the email confirmation link. Update to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, later phases
# NUTRITIONIX_APP_ID=
# NUTRITIONIX_APP_KEY=
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=
# FITBIT_CLIENT_ID=
